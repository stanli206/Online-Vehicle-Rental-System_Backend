terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = var.region
}

# ---------------------------------------------------------------------------
# SSH KEY PAIR — generated by Terraform (no manual console step)
# The private key is saved locally as rentgaadi-key.pem for SSH access.
# ---------------------------------------------------------------------------
resource "tls_private_key" "rentgaadi" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "rentgaadi" {
  key_name   = var.key_name
  public_key = tls_private_key.rentgaadi.public_key_openssh
}

resource "local_file" "private_key" {
  content         = tls_private_key.rentgaadi.private_key_pem
  filename        = "${path.module}/rentgaadi-key.pem"
  file_permission = "0400"
}

# ---------------------------------------------------------------------------
# LATEST UBUNTU 22.04 AMI (auto-resolved — no hardcoded AMI ID)
# ---------------------------------------------------------------------------
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ---------------------------------------------------------------------------
# SECURITY GROUP — SSH(22), HTTP(80), HTTPS(443)
# ---------------------------------------------------------------------------
resource "aws_security_group" "rentgaadi_sg" {
  name        = "rentgaadi-sg"
  description = "Allow SSH, HTTP and HTTPS inbound"

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "rentgaadi-sg"
  }
}

# ---------------------------------------------------------------------------
# EC2 INSTANCE — Docker installed automatically on first boot (user_data)
# ---------------------------------------------------------------------------
resource "aws_instance" "rentgaadi" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  key_name               = aws_key_pair.rentgaadi.key_name
  vpc_security_group_ids = [aws_security_group.rentgaadi_sg.id]
  user_data              = file("${path.module}/user_data.sh")

  root_block_device {
    volume_size = 20 # GB — free tier allows up to 30GB
    volume_type = "gp3"
  }

  tags = {
    Name = "rentgaadi-backend"
  }
}
