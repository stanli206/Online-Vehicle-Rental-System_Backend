# ---- RentGaadi backend environment variables ----
# Copy to ".env" and fill in real values. Never commit the real .env.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# Set to "production" on deployed servers (enables Secure + SameSite=None cookies)
NODE_ENV=development

# Database
MONGODB_URL=your_mongodb_connection_string

# Auth
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_separate_refresh_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (nodemailer)
EMAIL=your_email_address
EMAIL_PASSWORD=your_email_app_password

# Google Gemini (AI chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
